# Copy these entries into your PRIVATE .env; keep DB_SERVER and DB_NAME.
# Do not put a password, access token or device code here.
DB_AUTH_MODE=entra
AZURE_TENANT_ID=YOUR_DIRECTORY_TENANT_GUID
DB_ENTRA_OBJECT_ID=YOUR_READER_USER_OBJECT_GUID
DB_ENTRA_USERNAME=ocr-api-dev@YOUR_TENANT.onmicrosoft.com
